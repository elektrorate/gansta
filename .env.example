# Configuración pública de la app web Firebase. No incluir claves de servicio aquí.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Backend local. En Vercel usar / para llamar /api en el mismo origen.
VITE_API_URL=http://127.0.0.1:8787
# Demostración explícita en este dispositivo. Nunca sustituye un error de Firebase.
VITE_ENABLE_DEMO=true
# Solo backend; credenciales ADC fuera del repositorio.
GOOGLE_CLOUD_PROJECT=
APP_ORIGIN=http://localhost:8000
PORT=8787
# En Vercel: FIREBASE_SERVICE_ACCOUNT_JSON es una variable privada sensible,
# exclusiva de Production. Nunca usar el prefijo VITE_ ni versionar su valor.
