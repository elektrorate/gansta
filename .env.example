# Configuración pública de la app web Firebase. No incluir claves de servicio aquí.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# URL del backend Node (sin barra final). En local, http://localhost:8787
VITE_API_URL=http://localhost:8787
# Demostración explícita en este dispositivo. Nunca sustituye un error de Firebase.
VITE_ENABLE_DEMO=true
# Solo backend; credenciales ADC fuera del repositorio.
GOOGLE_CLOUD_PROJECT=
APP_ORIGIN=http://localhost:5173
PORT=8787
